rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function loggedIn() { return request.auth != null; }
    function isMe(uid) { return loggedIn() && request.auth.uid == uid; }
    function validText(text, lower, upper) {
      return text is string && text.size() >= lower && text.size() <= upper;
    }
    function validMediaLink(link) {
      return link is string && (link == '' || (link.size() <= 1500 && link.matches('https://[^ ]+')));
    }
    function validProfileMedia(data) {
      return validMediaLink(data.get('photoUrl', '')) && validMediaLink(data.get('videoUrl', ''));
    }
    function changedOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }
    function onlyMyArrayMembership(field) {
      return loggedIn()
        && resource.data[field] is list
        && request.resource.data[field] is list
        && changedOnly([field])
        && request.resource.data[field].toSet().difference(resource.data[field].toSet()).hasOnly([request.auth.uid])
        && resource.data[field].toSet().difference(request.resource.data[field].toSet()).hasOnly([request.auth.uid])
        && request.resource.data[field].toSet().size() == request.resource.data[field].size()
        && request.resource.data[field].size() <= resource.data[field].size() + 1
        && request.resource.data[field].size() >= resource.data[field].size() - 1;
    }
    function threadMember(appId, id) {
      return loggedIn()
        && request.auth.uid in get(/databases/$(database)/documents/artifacts/$(appId)/dm_threads/$(id)).data.participants;
    }
    function moderationPath(appId, uid, groupId) {
      return /databases/$(database)/documents/artifacts/$(appId)/public/data/members/$(uid)/moderation/$(groupId);
    }
    function managesGroup(appId, groupId, group) {
      return isMe(group.get('createdBy', '')) || (loggedIn()
        && request.auth.uid in group.members
        && get(moderationPath(appId, request.auth.uid, groupId)).data.status == 'active');
    }
    function moderatesPost(appId, post) {
      let groupId = post.get('groupId', '');
      return loggedIn() && validText(groupId, 1, 120) && groupId.matches('[^/]+')
        && managesGroup(appId, groupId,
          get(/databases/$(database)/documents/artifacts/$(appId)/public/data/groups/$(groupId)).data);
    }
    function publicPostPath(appId, postId) {
      return /databases/$(database)/documents/artifacts/$(appId)/public/data/posts/$(postId);
    }
    function removedPostPath(appId, postId) {
      return /databases/$(database)/documents/artifacts/$(appId)/public/data/removedPosts/$(postId);
    }
    function publicCommentPath(appId, postId, commentId) {
      return /databases/$(database)/documents/artifacts/$(appId)/public/data/posts/$(postId)/comments/$(commentId);
    }
    function removedCommentPath(appId, postId, commentId) {
      return /databases/$(database)/documents/artifacts/$(appId)/public/data/posts/$(postId)/removedComments/$(commentId);
    }
    function moderationLogPath(appId, groupId, entryId) {
      return /databases/$(database)/documents/artifacts/$(appId)/public/data/groups/$(groupId)/moderationLog/$(entryId);
    }
    function groupOwner(appId, groupId) {
      return isMe(get(/databases/$(database)/documents/artifacts/$(appId)/public/data/groups/$(groupId)).data.createdBy);
    }
    function archivedPostRemoval(appId, postId, post) {
      let archive = removedPostPath(appId, postId);
      return moderatesPost(appId, post) && !exists(archive) && existsAfter(archive);
    }
    function restoresGroupPost(appId, postId, post) {
      let groupId = post.get('groupId', '');
      let archive = removedPostPath(appId, postId);
      return validText(groupId, 1, 120) && groupId.matches('[^/]+') && groupOwner(appId, groupId)
        && exists(archive) && !existsAfter(archive)
        && get(archive).data.groupId == groupId
        && getAfter(moderationLogPath(appId, groupId, get(archive).data.entryId)).data.post == post;
    }
    function betweenUnblockedMembers(appId, participants) {
      return participants is list && participants.size() == 2
        && participants[0] is string && participants[1] is string
        && !exists(/databases/$(database)/documents/artifacts/$(appId)/public/data/members/$(participants[0])/blocked/$(participants[1]))
        && !exists(/databases/$(database)/documents/artifacts/$(appId)/public/data/members/$(participants[1])/blocked/$(participants[0]));
    }
    function canSendDirectMessage(appId, id) {
      let participants = get(/databases/$(database)/documents/artifacts/$(appId)/dm_threads/$(id)).data.participants;
      return request.auth.uid in participants && betweenUnblockedMembers(appId, participants);
    }
    function verifiedReportContent(report, author, content) {
      return author is string && author != request.auth.uid
        && report.targetUserId == author && report.targetText == content;
    }
    function verifiedPrivateReport(appId, report) {
      let message = get(/databases/$(database)/documents/artifacts/$(appId)/dm_threads/$(report.parentId)/messages/$(report.targetId)).data;
      return verifiedReportContent(report, message.senderId, message.text);
    }
    function verifiedCommunityReport(appId, report) {
      let message = get(/databases/$(database)/documents/artifacts/$(appId)/public/data/messages/$(report.targetId)).data;
      return verifiedReportContent(report, message.senderId, message.text);
    }
    function verifiedTestimonialReport(appId, report) {
      let entry = get(/databases/$(database)/documents/artifacts/$(appId)/public/data/members/$(report.parentId)/testimonials/$(report.targetId)).data;
      return (isMe(report.parentId) || entry.approved == true)
        && verifiedReportContent(report, report.targetId, entry.text);
    }
    function verifiedProfileReport(appId, report) {
      let profile = get(/databases/$(database)/documents/artifacts/$(appId)/public/data/members/$(report.targetId)).data;
      return verifiedReportContent(report, report.targetId, profile.name);
    }
    function validModerationReport(appId, report) {
      return report.keys().hasOnly(['reporterId', 'targetType', 'targetId', 'parentId', 'targetUserId', 'targetText', 'reason', 'details', 'createdAt', 'status'])
        && report.status == 'pending'
        && report.createdAt is number
        && validText(report.parentId, 0, 200)
        && report.parentId.matches('[^/]*')
        && validText(report.targetText, 1, 1500)
        && (
          (report.targetType == 'privateMessage' && threadMember(appId, report.parentId) && verifiedPrivateReport(appId, report))
          || (report.targetType == 'communityMessage' && report.parentId == '' && verifiedCommunityReport(appId, report))
          || (report.targetType == 'testimonial' && verifiedTestimonialReport(appId, report))
          || (report.targetType == 'profile' && report.parentId == '' && verifiedProfileReport(appId, report))
        );
    }

    // Perfis antigos: somente o próprio usuário pode ler para migrar.
    match /artifacts/{appId}/users/{uid}/profile/{profileId} {
      allow get: if isMe(uid) && profileId == 'data';
      allow list, create, update, delete: if false;
    }

    // Perfis públicos para usuários autenticados (cidade aproximada, não endereço).
    match /artifacts/{appId}/public/data/members/{uid} {
      allow read: if loggedIn();
      allow create: if isMe(uid)
        && request.resource.data.uid == uid
        && validText(request.resource.data.name, 1, 60)
        && validText(request.resource.data.location, 1, 90)
        && validText(request.resource.data.avatar, 1, 8)
        && validText(request.resource.data.bio, 0, 300)
        && validProfileMedia(request.resource.data)
        && request.resource.data.hobbies is list
        && request.resource.data.hobbies.size() <= 10;
      allow update: if isMe(uid)
        && resource.data.uid == uid
        && changedOnly(['name', 'location', 'avatar', 'bio', 'hobbies', 'photoUrl', 'videoUrl'])
        && validText(request.resource.data.name, 1, 60)
        && validText(request.resource.data.location, 1, 90)
        && validText(request.resource.data.avatar, 1, 8)
        && validText(request.resource.data.bio, 0, 300)
        && validProfileMedia(request.resource.data)
        && request.resource.data.hobbies is list
        && request.resource.data.hobbies.size() <= 10;
      allow delete: if false;

      match /saved/{postId} {
        allow read, create, delete: if isMe(uid);
        allow update: if false;
      }
      match /savedEvents/{eventId} {
        allow read, delete: if isMe(uid);
        allow create: if isMe(uid)
          && exists(/databases/$(database)/documents/artifacts/$(appId)/public/data/events/$(eventId))
          && request.resource.data.keys().hasOnly(['savedAt'])
          && request.resource.data.savedAt == request.time;
        allow update: if false;
      }
      // Private activity notices are coupled to their source write in the same commit.
      match /notificationReadState/main {
        function validReadState(data) {
          return data.keys().hasOnly(['keys']) && data['keys'] is list && data['keys'].size() <= 500;
        }
        allow get: if isMe(uid);
        allow create, update: if isMe(uid) && validReadState(request.resource.data);
        allow list, delete: if false;
      }
      match /notificationSettings/main {
        function validSettings(data) {
          return data.keys().hasOnly(['polls','bulletins','savedEvents','interactions','eventReminders'])
            && data.get('polls', true) is bool && data.get('bulletins', true) is bool
            && data.get('savedEvents', true) is bool && data.get('interactions', true) is bool
            && data.get('eventReminders','eve') in ['eve','day','both','off'];
        }
        allow get: if isMe(uid);
        allow create, update: if isMe(uid) && validSettings(request.resource.data);
        allow list, delete: if false;
      }
      match /mutedCommunities/{groupId} {
        allow read, delete: if isMe(uid);
        allow create: if isMe(uid)
          && uid in get(/databases/$(database)/documents/artifacts/$(appId)/public/data/groups/$(groupId)).data.members
          && request.resource.data.keys().hasOnly(['mutedAt'])
          && request.resource.data.mutedAt == request.time;
        allow update: if false;
      }
      match /notifications/{noticeId} {
        function newFollow(data) {
          let follow = /databases/$(database)/documents/artifacts/$(appId)/public/data/members/$(data.actorId)/following/$(uid);
          return noticeId == 'follow-' + data.actorId && data.postId == '' && data.commentId == ''
            && !exists(follow) && existsAfter(follow);
        }
        function newComment(data) {
          let comment = publicCommentPath(appId, data.postId, data.commentId);
          let reply = getAfter(comment).data;
          let parent = reply.get('parentId','');
          return noticeId == data.type + '-' + data.postId + ':' + data.commentId
            && !exists(comment) && reply.userId == data.actorId
            && ((data.type == 'comment' && parent == '' && get(publicPostPath(appId, data.postId)).data.userId == uid)
              || (data.type == 'comment-reply' && validText(parent, 1, 120) && parent.matches('[^/]+')
                && get(publicCommentPath(appId, data.postId, parent)).data.userId == uid));
        }
        function validNotice(data) {
          return loggedIn() && request.auth.uid != uid
            && data.keys().hasOnly(['type', 'actorId', 'postId', 'commentId', 'createdAt'])
            && data.actorId == request.auth.uid && data.createdAt == request.time
            && ((data.type == 'follow' && newFollow(data))
              || (data.type in ['comment','comment-reply'] && validText(data.postId, 1, 120) && data.postId.matches('[^/]+')
                && validText(data.commentId, 1, 120) && data.commentId.matches('[^/]+') && newComment(data)));
        }
        allow read: if isMe(uid);
        function newEventAnswer(data) {
          let event = /databases/$(database)/documents/artifacts/$(appId)/public/data/events/$(data.eventId);
          let question = /databases/$(database)/documents/artifacts/$(appId)/public/data/events/$(data.eventId)/questions/$(data.questionId);
          return get(event).data.createdBy == request.auth.uid && get(question).data.authorId == uid
            && get(question).data.get('answer', '') == ''
            && validText(getAfter(question).data.answer, 1, 600)
            && getAfter(question).data.answeredAt == request.time;
        }
        function validEventAnswerNotice(data) {
          return loggedIn() && request.auth.uid != uid && data.actorId == request.auth.uid
            && data.type == 'event-answer' && data.createdAt == request.time
            && data.keys().hasOnly(['type', 'actorId', 'eventId', 'questionId', 'createdAt'])
            && validText(data.eventId, 1, 120) && data.eventId.matches('[^/]+')
            && validText(data.questionId, 1, 120) && data.questionId.matches('[^/]+')
            && noticeId == 'event-answer-' + data.eventId + ':' + data.questionId && newEventAnswer(data);
        }
        allow create: if validNotice(request.resource.data) || validEventAnswerNotice(request.resource.data);
        allow update: if request.resource.data.type == 'follow' && validNotice(request.resource.data);
        allow delete: if false;
      }
      match /following/{targetId} {
        // A consulta do dono lista a coleção inteira, sem filtrar por targetId.
        allow list: if isMe(uid);
        allow get, create, delete: if isMe(uid) && targetId != uid;
        allow update: if false;
      }
      match /blocked/{targetId} {
        allow read, delete: if isMe(uid);
        allow create: if isMe(uid) && uid != targetId
          && request.resource.data.keys().hasOnly(['createdAt'])
          && request.resource.data.createdAt is number;
        allow update: if false;
      }
      match /privateReads/{threadId} {
        function validReadTime() {
          return request.resource.data.keys().hasOnly(['lastReadAt'])
            && request.resource.data.lastReadAt is number
            && request.resource.data.lastReadAt >= 0;
        }
        allow read: if isMe(uid);
        allow create: if isMe(uid) && threadMember(appId, threadId) && validReadTime();
        allow update: if isMe(uid) && threadMember(appId, threadId) && validReadTime()
          && request.resource.data.lastReadAt >= resource.data.lastReadAt;
        allow delete: if false;
      }
      match /eventReads/{eventId} {
        function validEventRead() {
          let event = get(/databases/$(database)/documents/artifacts/$(appId)/public/data/events/$(eventId)).data;
          return uid in event.attendees
            && request.resource.data.keys().hasOnly(['revision'])
            && request.resource.data.revision is int
            && request.resource.data.revision > 0
            && request.resource.data.revision <= event.get('revision', 0);
        }
        allow read: if isMe(uid);
        allow create: if isMe(uid) && validEventRead();
        allow update: if isMe(uid) && validEventRead()
          && request.resource.data.revision >= resource.data.revision;
        allow delete: if false;
      }
      match /moderation/{groupId} {
        function groupData() {
          return getAfter(/databases/$(database)/documents/artifacts/$(appId)/public/data/groups/$(groupId)).data;
        }
        function validRole(status) {
          return request.resource.data.keys().hasOnly(['status'])
            && request.resource.data.status == status && uid in groupData().members;
        }
        allow get: if isMe(uid) || isMe(get(/databases/$(database)/documents/artifacts/$(appId)/public/data/groups/$(groupId)).data.createdBy);
        allow list: if isMe(uid);
        allow create: if isMe(groupData().createdBy) && uid != request.auth.uid && validRole('pending');
        allow update: if isMe(uid) && resource.data.status == 'pending' && validRole('active');
        allow delete: if isMe(uid) || isMe(groupData().createdBy);
      }
      match /testimonials/{authorId} {
        allow get: if isMe(uid) || isMe(authorId) || (loggedIn() && resource.data.approved == true);
        allow list: if isMe(uid) || (loggedIn() && resource.data.approved == true);
        allow create: if isMe(authorId) && authorId != uid
          && request.resource.data.keys().hasOnly(['text', 'createdAt', 'approved'])
          && validText(request.resource.data.text, 1, 600)
          && request.resource.data.createdAt is number
          && request.resource.data.approved == false;
        allow update: if isMe(uid)
          && changedOnly(['approved'])
          && request.resource.data.approved is bool;
        allow delete: if isMe(uid) || isMe(authorId);
      }
    }

    match /artifacts/{appId}/public/data/posts/{postId} {
      allow read: if loggedIn();
      allow create: if loggedIn() && (ordinaryPost() || restoresGroupPost(appId, postId, request.resource.data));
      function ordinaryPost() {
        return request.resource.data.userId == request.auth.uid
        && request.resource.data.likes == []
        && !request.resource.data.keys().hasAny(['editedAt'])
        && validText(request.resource.data.content, 1, 2000)
        && validText(request.resource.data.hobby, 1, 60)
        && validText(request.resource.data.location, 1, 90)
        && validText(request.resource.data.userName, 1, 60)
        && request.resource.data.createdAt is number
        && (!request.resource.data.keys().hasAny(['groupId'])
          || (exists(/databases/$(database)/documents/artifacts/$(appId)/public/data/groups/$(request.resource.data.groupId))
            && request.auth.uid in get(/databases/$(database)/documents/artifacts/$(appId)/public/data/groups/$(request.resource.data.groupId)).data.members))
        && (!request.resource.data.keys().hasAny(['eventRecapId']) || validEventRecap(request.resource.data))
        && !exists(removedPostPath(appId, postId));
      }
      function validEventRecap(data) {
        return validText(data.eventRecapId, 1, 120) && data.eventRecapId.matches('[^/]+')
          && validRecapEvent(data, get(/databases/$(database)/documents/artifacts/$(appId)/public/data/events/$(data.eventRecapId)).data);
      }
      function validRecapEvent(post, event) {
        let date = event.date.split('-');
        return event.createdBy == request.auth.uid && event.groupId == post.groupId
          && event.get('cancelled', false) != true
          && event.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
          && (request.time - duration.value(3, 'h')).date() > timestamp.date(int(date[0]), int(date[1]), int(date[2]));
      }
      allow update: if onlyMyArrayMembership('likes');
      allow update: if isMe(resource.data.userId)
        && changedOnly(['content','editedAt'])
        && request.resource.data.content != resource.data.content
        && validText(request.resource.data.content, 1, 2000)
        && request.resource.data.content.matches('(?s).*[^\\s].*')
        && request.resource.data.editedAt == request.time;
      allow delete: if loggedIn() && (resource.data.userId == request.auth.uid || archivedPostRemoval(appId, postId, resource.data));

      match /comments/{commentId} {
        function validReplyParent(data) {
          let parent = data.get('parentId','');
          return !data.keys().hasAny(['parentId'])
            || (validText(parent, 1, 120) && parent.matches('[^/]+')
              && exists(publicCommentPath(appId, postId, parent))
              && !get(publicCommentPath(appId, postId, parent)).data.keys().hasAny(['parentId']));
        }
        function restoresComment() {
          let pointer = get(removedCommentPath(appId, postId, commentId)).data;
          let groupId = get(publicPostPath(appId, postId)).data.get('groupId', '');
          return pointer.groupId == groupId && groupOwner(appId, groupId)
            && !existsAfter(removedCommentPath(appId, postId, commentId))
            && getAfter(moderationLogPath(appId, groupId, pointer.entryId)).data.comment == request.resource.data;
        }
        allow read: if loggedIn() && exists(publicPostPath(appId, postId));
        allow create: if loggedIn() && exists(publicPostPath(appId, postId)) && (
          (!exists(removedCommentPath(appId, postId, commentId))
          && request.resource.data.userId == request.auth.uid
          && !request.resource.data.keys().hasAny(['editedAt'])
          && validReplyParent(request.resource.data)
          && validText(request.resource.data.text, 1, 800)
          && request.resource.data.createdAt is number) || restoresComment());
        allow delete: if loggedIn() && exists(publicPostPath(appId, postId)) && (resource.data.userId == request.auth.uid
          || (moderatesPost(appId, get(publicPostPath(appId, postId)).data)
            && !exists(removedCommentPath(appId, postId, commentId))
            && existsAfter(removedCommentPath(appId, postId, commentId))));
        allow update: if isMe(resource.data.userId) && exists(publicPostPath(appId, postId))
          && changedOnly(['text','editedAt'])
          && request.resource.data.text != resource.data.text
          && validText(request.resource.data.text, 1, 800)
          && request.resource.data.text.matches('(?s).*[^\\s].*')
          && request.resource.data.editedAt == request.time;
      }
      match /removedComments/{commentId} {
        function validCommentPointer(data) {
          let post = get(publicPostPath(appId, postId)).data;
          let log = moderationLogPath(appId, data.groupId, data.entryId);
          return data.keys().hasOnly(['groupId', 'entryId'])
            && data.groupId == post.groupId && moderatesPost(appId, post)
            && validText(data.entryId, 1, 120) && data.entryId.matches('[^/]+')
            && !exists(log) && getAfter(log).data.postId == postId
            && getAfter(log).data.commentId == commentId;
        }
        allow create: if loggedIn() && validCommentPointer(request.resource.data);
        allow delete: if loggedIn() && groupOwner(appId, resource.data.groupId)
          && getAfter(publicCommentPath(appId, postId, commentId)).data
            == get(moderationLogPath(appId, resource.data.groupId, resource.data.entryId)).data.comment
          && getAfter(moderationLogPath(appId, resource.data.groupId, resource.data.entryId)).data.restoredAt == request.time;
        allow read, update: if false;
      }
    }

    match /artifacts/{appId}/public/data/removedPosts/{postId} {
      function validPointer(data) {
        return data.keys().hasOnly(['groupId', 'entryId'])
          && validText(data.groupId, 1, 120) && data.groupId.matches('[^/]+')
          && validText(data.entryId, 1, 120) && data.entryId.matches('[^/]+');
      }
      allow create: if loggedIn() && validPointer(request.resource.data)
        && moderatesPost(appId, {'groupId': request.resource.data.groupId})
        && !exists(moderationLogPath(appId, request.resource.data.groupId, request.resource.data.entryId))
        && getAfter(moderationLogPath(appId, request.resource.data.groupId, request.resource.data.entryId)).data.postId == postId
        && !getAfter(moderationLogPath(appId, request.resource.data.groupId, request.resource.data.entryId)).data.keys().hasAny(['commentId']);
      allow delete: if loggedIn() && groupOwner(appId, resource.data.groupId)
        && getAfter(publicPostPath(appId, postId)).data == get(moderationLogPath(appId, resource.data.groupId, resource.data.entryId)).data.post
        && getAfter(moderationLogPath(appId, resource.data.groupId, resource.data.entryId)).data.restoredAt == request.time;
      allow read, update: if false;
    }

    match /artifacts/{appId}/public/data/groups/{groupId} {
      function canPinGroupPost() {
        let postId = request.resource.data.pinnedPostId;
        return managesGroup(appId, groupId, resource.data)
          && changedOnly(['pinnedPostId'])
          && postId is string
          && (postId == '' || (validText(postId, 1, 120)
            && postId.matches('[^/]+')
            && get(/databases/$(database)/documents/artifacts/$(appId)/public/data/posts/$(postId)).data.groupId == groupId));
      }
      allow read: if loggedIn();
      allow create: if loggedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.members == [request.auth.uid]
        && !request.resource.data.keys().hasAny(['pinnedPostId'])
        && validText(request.resource.data.name, 3, 75)
        && validText(request.resource.data.hobby, 1, 60)
        && validText(request.resource.data.description, 1, 600)
        && validText(request.resource.data.location, 1, 90);
      allow update: if (onlyMyArrayMembership('members')
          && (request.auth.uid in request.resource.data.members
            || !existsAfter(moderationPath(appId, request.auth.uid, groupId))))
        || canPinGroupPost();
      allow delete: if loggedIn() && resource.data.get('createdBy', '') == request.auth.uid;

      function canReviewModeration() {
        return managesGroup(appId, groupId,
          get(/databases/$(database)/documents/artifacts/$(appId)/public/data/groups/$(groupId)).data);
      }
      match /polls/{pollId} {
        function pollPath() {
          return /databases/$(database)/documents/artifacts/$(appId)/public/data/groups/$(groupId)/polls/$(pollId);
        }
        function totalsPath() {
          return /databases/$(database)/documents/artifacts/$(appId)/public/data/groups/$(groupId)/polls/$(pollId)/totals/main;
        }
        function votePath(uid) {
          return /databases/$(database)/documents/artifacts/$(appId)/public/data/groups/$(groupId)/polls/$(pollId)/votes/$(uid);
        }
        function pollMember() {
          return loggedIn() && request.auth.uid in get(
            /databases/$(database)/documents/artifacts/$(appId)/public/data/groups/$(groupId)).data.members;
        }
        function validPoll(data) {
          let options = data.options;
          return data.keys().hasOnly(['question', 'options', 'createdBy', 'createdAt', 'endsAt'])
            && data.createdBy == request.auth.uid && data.createdAt == request.time
            && data.endsAt is timestamp && data.endsAt > request.time
            && data.endsAt <= request.time + duration.value(8, 'd')
            && validText(data.question, 3, 160)
            && options.keys().hasOnly(['a', 'b', 'c', 'd'])
            && validText(options.a, 1, 80) && validText(options.b, 1, 80)
            && validText(options.c, 0, 80) && validText(options.d, 0, 80)
            && (options.c != '' || options.d == '')
            && options.a != options.b
            && (options.c == '' || (options.c != options.a && options.c != options.b))
            && (options.d == '' || (options.d != options.a && options.d != options.b && options.d != options.c));
        }
        function validVote(data, poll) {
          return data.keys().hasOnly(['option'])
            && data.option in ['a', 'b', 'c', 'd'] && poll.options[data.option] != ''
            && request.time < poll.endsAt;
        }
        function countMatches(before, after, key, oldChoice, newChoice) {
          return after[key] is int && after[key] >= 0
            && after[key] == before[key] + (newChoice == key ? 1 : 0) - (oldChoice == key ? 1 : 0);
        }
        function validTotals(before, after, oldChoice, newChoice) {
          return oldChoice != newChoice && after.keys().hasOnly(['a', 'b', 'c', 'd'])
            && countMatches(before, after, 'a', oldChoice, newChoice)
            && countMatches(before, after, 'b', oldChoice, newChoice)
            && countMatches(before, after, 'c', oldChoice, newChoice)
            && countMatches(before, after, 'd', oldChoice, newChoice);
        }
        function writesVote(data, oldChoice) {
          return pollMember() && validVote(data, get(pollPath()).data)
            && validTotals(get(totalsPath()).data, getAfter(totalsPath()).data, oldChoice, data.option);
        }
        function writesTotals() {
          let ballot = votePath(request.auth.uid);
          let oldChoice = exists(ballot) ? get(ballot).data.option : '';
          let newVote = getAfter(ballot).data;
          return validVote(newVote, get(pollPath()).data)
            && validTotals(resource.data, request.resource.data, oldChoice, newVote.option);
        }
        allow read: if pollMember();
        allow create: if pollMember() && canReviewModeration() && validPoll(request.resource.data)
          && getAfter(totalsPath()).data == {'a': 0, 'b': 0, 'c': 0, 'd': 0};
        allow update, delete: if false;

        match /votes/{uid} {
          allow get: if pollMember() && isMe(uid);
          allow create: if isMe(uid) && writesVote(request.resource.data, '');
          allow update: if isMe(uid) && writesVote(request.resource.data, resource.data.option);
          allow list, delete: if false;
        }
        match /totals/main {
          allow get: if pollMember() && (exists(votePath(request.auth.uid))
            || request.time >= get(pollPath()).data.endsAt);
          allow create: if pollMember() && canReviewModeration() && !exists(pollPath())
            && validPoll(getAfter(pollPath()).data)
            && request.resource.data == {'a': 0, 'b': 0, 'c': 0, 'd': 0};
          allow update: if pollMember() && writesTotals();
          allow list, delete: if false;
        }
      }
      match /reports/{reportId} {
        function currentTarget(data) {
          return data.targetType == 'post'
            ? get(publicPostPath(appId, data.postId)).data
            : get(publicCommentPath(appId, data.postId, data.commentId)).data;
        }
        function available(data) {
          return exists(publicPostPath(appId, data.postId))
            && get(publicPostPath(appId, data.postId)).data.groupId == groupId
            && (data.targetType == 'post' || exists(publicCommentPath(appId, data.postId, data.commentId)));
        }
        function verifiedTarget(data) {
          let post = get(publicPostPath(appId, data.postId)).data;
          let target = currentTarget(data);
          return post.groupId == groupId && target.userId is string && target.userId != request.auth.uid
            && data.text == (data.targetType == 'post' ? target.content : target.text);
        }
        function linkedRemoval(data) {
          let entry = getAfter(moderationLogPath(appId, groupId, data.moderationId)).data;
          return entry.postId == resource.data.postId
            && entry.get('commentId', '') == resource.data.commentId
            && entry.removedBy == request.auth.uid && entry.removedAt == request.time;
        }
        allow read: if loggedIn() && canReviewModeration();
        allow create: if loggedIn() && request.auth.uid in get(
            /databases/$(database)/documents/artifacts/$(appId)/public/data/groups/$(groupId)).data.members
          && request.resource.data.keys().hasOnly(['targetType', 'postId', 'commentId', 'text', 'reason', 'details', 'reporterId', 'createdAt', 'status'])
          && request.resource.data.reporterId == request.auth.uid
          && request.resource.data.createdAt == request.time && request.resource.data.status == 'pending'
          && validText(request.resource.data.postId, 1, 120) && request.resource.data.postId.matches('[^/]+')
          && ((request.resource.data.targetType == 'post' && request.resource.data.commentId == '')
            || (request.resource.data.targetType == 'comment' && validText(request.resource.data.commentId, 1, 120)
              && request.resource.data.commentId.matches('[^/]+')))
          && validText(request.resource.data.text, 1, 2000)
          && validText(request.resource.data.reason, 1, 80) && validText(request.resource.data.details, 0, 500)
          && verifiedTarget(request.resource.data);
        allow update: if loggedIn() && canReviewModeration() && resource.data.status == 'pending'
          && changedOnly(['status', 'reviewedAt', 'reviewedBy', 'moderationId'])
          && request.resource.data.reviewedAt == request.time && request.resource.data.reviewedBy == request.auth.uid
          && ((request.resource.data.moderationId == ''
                && ((request.resource.data.status == 'kept' && available(resource.data))
                  || (request.resource.data.status == 'unavailable' && !available(resource.data))))
            || (request.resource.data.status == 'removed' && validText(request.resource.data.moderationId, 1, 120)
              && request.resource.data.moderationId.matches('[^/]+') && linkedRemoval(request.resource.data)));
        allow delete: if false;
      }
      match /moderationLog/{entryId} {
        function recordsPostRemoval(data) {
          return data.keys().hasOnly(['postId', 'post', 'reason', 'removedBy', 'removedAt'])
            && data.post.groupId == groupId
            && data.post == get(publicPostPath(appId, data.postId)).data
            && !existsAfter(publicPostPath(appId, data.postId))
            && getAfter(removedPostPath(appId, data.postId)).data == {'groupId': groupId, 'entryId': entryId};
        }
        function recordsCommentRemoval(data) {
          return data.keys().hasOnly(['postId', 'commentId', 'comment', 'reason', 'removedBy', 'removedAt'])
            && validText(data.commentId, 1, 120) && data.commentId.matches('[^/]+')
            && get(publicPostPath(appId, data.postId)).data.groupId == groupId
            && data.comment == get(publicCommentPath(appId, data.postId, data.commentId)).data
            && !existsAfter(publicCommentPath(appId, data.postId, data.commentId))
            && getAfter(removedCommentPath(appId, data.postId, data.commentId)).data == {'groupId': groupId, 'entryId': entryId};
        }
        function restoresLogEntry(entry) {
          return entry.keys().hasAny(['commentId'])
            ? (get(removedCommentPath(appId, entry.postId, entry.commentId)).data == {'groupId': groupId, 'entryId': entryId}
              && !existsAfter(removedCommentPath(appId, entry.postId, entry.commentId))
              && getAfter(publicCommentPath(appId, entry.postId, entry.commentId)).data == entry.comment)
            : (get(removedPostPath(appId, entry.postId)).data == {'groupId': groupId, 'entryId': entryId}
              && !existsAfter(removedPostPath(appId, entry.postId))
              && getAfter(publicPostPath(appId, entry.postId)).data == entry.post);
        }
        allow read: if loggedIn() && canReviewModeration();
        allow create: if loggedIn() && canReviewModeration()
          && validText(request.resource.data.postId, 1, 120)
          && request.resource.data.postId.matches('[^/]+')
          && validText(request.resource.data.reason, 1, 300)
          && request.resource.data.removedBy == request.auth.uid
          && request.resource.data.removedAt == request.time
          && (request.resource.data.keys().hasAny(['commentId'])
            ? recordsCommentRemoval(request.resource.data) : recordsPostRemoval(request.resource.data));
        allow update: if loggedIn() && groupOwner(appId, groupId)
          && changedOnly(['restoredBy', 'restoredAt'])
          && !resource.data.keys().hasAny(['restoredAt'])
          && request.resource.data.restoredBy == request.auth.uid
          && request.resource.data.restoredAt == request.time
          && restoresLogEntry(resource.data);
        allow delete: if false;
      }
    }

    match /artifacts/{appId}/public/data/events/{eventId} {
      function canAttend(data) {
        let groupId = data.get('groupId', '');
        return !data.keys().hasAny(['groupId'])
          || (validText(groupId, 1, 120) && groupId.matches('[^/]+')
            && request.auth.uid in get(/databases/$(database)/documents/artifacts/$(appId)/public/data/groups/$(groupId)).data.members);
      }
      function capacityFields(data) {
        return !data.keys().hasAny(['capacity','waitlist','offerAt'])
          || (data.capacity is int && data.capacity >= 2 && data.capacity <= 200
            && data.waitlist == [] && data.offerAt == null);
      }
      function firstIn(line) {
        return line.size() > 0 ? line[0] : '';
      }
      function offerValid(before, after) {
        let reserved = after.attendees.size() < after.capacity && after.waitlist.size() > 0;
        let sameHead = firstIn(before.waitlist) == firstIn(after.waitlist) && before.offerAt is timestamp;
        return after.offerAt == (reserved ? (sameHead ? before.offerAt : request.time) : null);
      }
      function limitedRsvp() {
        let before = resource.data;
        let after = request.resource.data;
        let uid = request.auth.uid;
        let onList = uid in before.waitlist;
        let expired = before.offerAt is timestamp && request.time >= before.offerAt + duration.value(1,'h');
        let joined = after.attendees == before.attendees.concat([uid])
          && !(uid in before.attendees) && after.attendees.size() <= before.capacity && canAttend(before)
          && (before.waitlist.size() == 0 || (firstIn(before.waitlist) == uid && !expired && before.offerAt is timestamp))
          && after.waitlist == before.waitlist.removeAll([uid]);
        let left = uid in before.attendees && after.attendees == before.attendees.removeAll([uid])
          && after.waitlist == before.waitlist;
        let queueUpdated = before.attendees == after.attendees
          && ((onList && after.waitlist == before.waitlist.removeAll([uid]))
            || (!onList && !(uid in before.attendees) && canAttend(before)
              && (before.attendees.size() >= before.capacity || before.waitlist.size() > 0)
              && before.waitlist.size() < 100 && after.waitlist == before.waitlist.concat([uid]))
            || (expired && after.waitlist == before.waitlist.removeAll([firstIn(before.waitlist)])));
        return before.get('cancelled', false) != true
          && changedOnly(['attendees', 'waitlist', 'offerAt'])
          && (joined || left || queueUpdated) && offerValid(before, after);
      }
      function validEventEndTime(data) {
        let finish = data.get('endTime', '');
        return finish == '' || (finish is string
          && finish.matches('([01][0-9]|2[0-3]):[0-5][0-9]')
          && data.time.matches('([01][0-9]|2[0-3]):[0-5][0-9]')
          && int(finish.replace(':', '')) > int(data.time.replace(':', '')));
      }
      function validPreviousEventSchedule() {
        let before = resource.data;
        let after = request.resource.data;
        let previous = {'date': before.date, 'time': before.time, 'location': before.location, 'revision': after.revision};
        let previousLocation = after.get('format','') == 'online' && before.location.matches('(?i).*(https?://|www[.]).*')
          ? 'Online' : before.location;
        return after.previousSchedule == {
          'date': before.date, 'time': before.time, 'endTime': before.get('endTime', ''),
          'timeZone': before.get('timeZone',''), 'location': previousLocation, 'revision': after.revision
        } || (after.get('timeZone','') == before.get('timeZone','') && (after.previousSchedule == {
          'date': before.date, 'time': before.time, 'endTime': before.get('endTime', ''),
          'location': previousLocation, 'revision': after.revision
        } || (after.get('endTime','') == before.get('endTime','')
          && after.get('format','') == before.get('format','') && after.previousSchedule == previous)));
      }
      function eventRoomPath() {
        return /databases/$(database)/documents/artifacts/$(appId)/public/data/events/$(eventId)/private/room;
      }
      function validEventFormat(data) {
        let format = data.get('format','');
        return !data.keys().hasAny(['roomUrl'])
          && (!data.keys().hasAny(['format'])
            || (format == 'in-person' && !existsAfter(eventRoomPath()))
            || (format == 'online' && data.location == 'Online'
              && getAfter(eventRoomPath()).data.ownerId == data.createdBy));
      }
      function validEventTimeZone(data) {
        let zone = data.get('timeZone','');
        return zone == '' || (data.get('format','') == 'online'
          && zone in ['America/Sao_Paulo','America/Manaus','America/Rio_Branco','America/Noronha','UTC']);
      }
      function organizerChange() {
        return isMe(resource.data.createdBy) && resource.data.get('cancelled', false) != true
          && request.resource.data.revision is int
          && request.resource.data.revision == resource.data.get('revision', 0) + 1
          && (request.resource.data.get('scheduleChangedAt', null) == resource.data.get('scheduleChangedAt', null)
            || request.resource.data.scheduleChangedAt == request.time)
          && ((changedOnly(['date', 'time', 'endTime', 'timeZone', 'format', 'location', 'revision', 'previousSchedule', 'scheduleChangedAt'])
              && request.resource.data.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
              && request.resource.data.time.matches('([01][0-9]|2[0-3]):[0-5][0-9]')
              && validEventEndTime(request.resource.data)
              && validEventFormat(request.resource.data)
              && validEventTimeZone(request.resource.data)
              && validText(request.resource.data.location, 1, 120)
              && (changedOnly(['date', 'time', 'location', 'revision', 'scheduleChangedAt'])
                || validPreviousEventSchedule()))
            || (changedOnly(['cancelled', 'revision', 'scheduleChangedAt']) && request.resource.data.cancelled == true));
      }
      allow read: if loggedIn();
      allow create: if loggedIn()
        && canAttend(request.resource.data)
        && capacityFields(request.resource.data)
        && !request.resource.data.keys().hasAny(['cancelled', 'revision', 'previousSchedule', 'scheduleChangedAt'])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.attendees == [request.auth.uid]
        && validText(request.resource.data.title, 3, 90)
        && validText(request.resource.data.hobby, 1, 60)
        && validText(request.resource.data.location, 1, 120)
        && validText(request.resource.data.description, 1, 800)
        && validText(request.resource.data.date, 10, 10)
        && validText(request.resource.data.time, 5, 5)
        && validEventEndTime(request.resource.data)
        && validEventFormat(request.resource.data)
        && validEventTimeZone(request.resource.data);
      allow update: if (!resource.data.keys().hasAny(['capacity']) && onlyMyArrayMembership('attendees')
          && (!(request.auth.uid in request.resource.data.attendees)
            || (resource.data.get('cancelled', false) != true && canAttend(resource.data))))
        || (loggedIn() && resource.data.keys().hasAny(['capacity']) && limitedRsvp())
        || organizerChange();
      allow delete: if loggedIn() && resource.data.createdBy == request.auth.uid;

      function discussionEvent() {
        return /databases/$(database)/documents/artifacts/$(appId)/public/data/events/$(eventId);
      }
      function discussionOpen() {
        return exists(discussionEvent()) && get(discussionEvent()).data.get('cancelled', false) != true;
      }
      function discussionOrganizer() {
        return isMe(get(discussionEvent()).data.createdBy);
      }
      match /private/room {
        function roomEventAfter() {
          return getAfter(discussionEvent()).data;
        }
        allow get: if loggedIn() && discussionOpen() && get(discussionEvent()).data.get('format','') == 'online'
          && resource.data.ownerId == get(discussionEvent()).data.createdBy
          && (discussionOrganizer() || request.auth.uid in get(discussionEvent()).data.attendees);
        allow create, update: if isMe(roomEventAfter().createdBy) && roomEventAfter().get('format','') == 'online'
          && roomEventAfter().get('cancelled',false) != true
          && request.resource.data.keys().hasOnly(['url','ownerId'])
          && request.resource.data.ownerId == request.auth.uid
          && validText(request.resource.data.url, 9, 2048)
          && request.resource.data.url.matches('https://[^\\s]+');
        allow delete: if isMe(roomEventAfter().createdBy) && roomEventAfter().get('format','') == 'in-person';
      }
      match /checkins/{uid} {
        function canRecordArrival() {
          let event = get(discussionEvent()).data;
          let day = event.date.split('-');
          return discussionOrganizer() && event.get('cancelled', false) != true
            && event.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
            && (request.time - duration.value(3, 'h')).date() == timestamp.date(int(day[0]), int(day[1]), int(day[2]));
        }
        allow get: if discussionOrganizer() || (isMe(uid) && exists(discussionEvent()));
        allow list: if discussionOrganizer();
        allow create: if canRecordArrival() && uid in get(discussionEvent()).data.attendees
          && request.resource.data.keys().hasOnly(['checkedAt'])
          && request.resource.data.checkedAt == request.time;
        allow update: if false;
        allow delete: if canRecordArrival();
      }
      match /bulletins/{bulletinId} {
        function canReadBulletins() {
          let event = get(discussionEvent()).data;
          return loggedIn() && (event.createdBy == request.auth.uid || request.auth.uid in event.attendees);
        }
        allow read: if canReadBulletins();
        allow create: if discussionOpen() && discussionOrganizer()
          && request.resource.data.keys().hasOnly(['text','createdAt'])
          && validText(request.resource.data.text, 3, 500)
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
      match /questions/{questionId} {
        allow read: if loggedIn() && exists(discussionEvent());
        allow create: if loggedIn() && discussionOpen()
          && request.resource.data.keys().hasOnly(['authorId', 'question', 'createdAt'])
          && request.resource.data.authorId == request.auth.uid
          && validText(request.resource.data.question, 3, 400)
          && request.resource.data.createdAt == request.time;
        allow update: if discussionOpen() && discussionOrganizer()
          && changedOnly(['answer', 'answeredAt'])
          && validText(request.resource.data.answer, 1, 600)
          && request.resource.data.answeredAt == request.time;
        allow delete: if false;
      }
      match /discussion/pinned {
        function validPin(data) {
          let questionId = data.questionId;
          return data.keys().hasOnly(['questionId'])
            && validText(questionId, 1, 120) && questionId.matches('[^/]+')
            && validText(get(/databases/$(database)/documents/artifacts/$(appId)/public/data/events/$(eventId)/questions/$(questionId)).data.answer, 1, 600);
        }
        allow get: if loggedIn() && exists(discussionEvent());
        allow create, update: if discussionOpen() && discussionOrganizer() && validPin(request.resource.data);
        allow delete: if discussionOpen() && discussionOrganizer();
      }
      match /feedback/{uid} {
        function eventData() {
          return get(/databases/$(database)/documents/artifacts/$(appId)/public/data/events/$(eventId)).data;
        }
        function canGiveFeedback() {
          let event = eventData();
          let date = event.date.split('-');
          return event.get('cancelled', false) != true
            && (uid in event.attendees || exists(/databases/$(database)/documents/artifacts/$(appId)/public/data/events/$(eventId)/checkins/$(uid)))
            && event.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
            && (request.time - duration.value(3, 'h')).date()
              > timestamp.date(int(date[0]), int(date[1]), int(date[2]));
        }
        allow get: if isMe(uid) || isMe(eventData().createdBy);
        allow list: if isMe(eventData().createdBy);
        allow create, update: if isMe(uid) && canGiveFeedback()
          && request.resource.data.keys().hasOnly(['attended', 'comment', 'updatedAt'])
          && request.resource.data.attended is bool
          && validText(request.resource.data.comment, 0, 500)
          && request.resource.data.updatedAt == request.time;
        allow delete: if false;
      }
    }

    match /artifacts/{appId}/public/data/messages/{messageId} {
      allow read: if loggedIn();
      allow create: if loggedIn()
        && request.resource.data.senderId == request.auth.uid
        && validText(request.resource.data.text, 1, 1500)
        && validText(request.resource.data.location, 1, 90)
        && request.resource.data.createdAt is number;
      allow update: if false;
      allow delete: if loggedIn() && resource.data.senderId == request.auth.uid;
    }

    // Mensagens realmente segregadas por par de participantes.
    // NÃO disponibilizar a coleção legada public/data/private_messages.
    match /artifacts/{appId}/dm_threads/{id} {
      // A transação precisa ler o documento ausente antes de criá-lo.
      allow get: if loggedIn()
        && (resource == null || request.auth.uid in resource.data.participants);
      allow list: if loggedIn() && request.auth.uid in resource.data.participants;
      allow create: if loggedIn()
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.resource.data.participants.toSet().size() == 2
        && request.auth.uid in request.resource.data.participants
        && betweenUnblockedMembers(appId, request.resource.data.participants);
      allow update, delete: if false;
      match /messages/{messageId} {
        allow read: if threadMember(appId, id);
        allow create: if loggedIn() && canSendDirectMessage(appId, id)
          && request.resource.data.senderId == request.auth.uid
          && validText(request.resource.data.text, 1, 1500)
          && request.resource.data.createdAt is number;
        allow update, delete: if false;
      }
    }

    // Usuários podem enviar denúncias; a análise é administrativa no Firebase.
    match /artifacts/{appId}/public/data/reports/{reportId} {
      allow create: if loggedIn()
        && request.resource.data.reporterId == request.auth.uid
        && validText(request.resource.data.targetId, 1, 200)
        && request.resource.data.targetId.matches('[^/]+')
        && validText(request.resource.data.reason, 1, 80)
        && validText(request.resource.data.details, 0, 500)
        && ((request.resource.data.targetType == 'post'
            && request.resource.data.keys().hasOnly(['reporterId', 'targetType', 'targetId', 'reason', 'details', 'createdAt'])
            && request.resource.data.createdAt is number)
          || validModerationReport(appId, request.resource.data));
      allow read, update, delete: if false;
    }

    function canTriageProductFeedback(appId) {
      return loggedIn() && request.auth.token.email_verified == true
        && hasFeedbackAdminRole(appId, request.auth.uid);
    }
    function hasFeedbackAdminRole(appId, uid) {
      let role = get(/databases/$(database)/documents/artifacts/$(appId)/feedbackAdmins/$(uid)).data;
      return role.active == true && role.email == request.auth.token.email;
    }
    match /artifacts/{appId}/feedbackAdmins/{uid} {
      allow get: if isMe(uid);
      allow list, create, update, delete: if false;
    }
    match /artifacts/{appId}/productFeedback/{feedbackId} {
      function feedbackPath() {
        return /databases/$(database)/documents/artifacts/$(appId)/productFeedback/$(feedbackId);
      }
      function supplementPath(id) {
        return /databases/$(database)/documents/artifacts/$(appId)/productFeedback/$(feedbackId)/supplements/$(id);
      }
      function marksNewSupplement() {
        let id = request.resource.data.lastSupplementId;
        return validText(id, 1, 128)
          && request.resource.data.hasUnreadSupplements == true
          && !exists(supplementPath(id))
          && getAfter(supplementPath(id)).data.createdAt == request.time;
      }
      allow create: if loggedIn()
        && request.resource.data.keys().hasOnly(['authorId', 'category', 'message', 'createdAt', 'status'])
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.category in ['problem', 'suggestion']
        && validText(request.resource.data.message, 3, 600)
        && request.resource.data.createdAt == request.time
        && request.resource.data.status == 'new';
      allow read: if isMe(resource.data.authorId) || canTriageProductFeedback(appId);
      allow update: if canTriageProductFeedback(appId)
        && changedOnly(['status','reviewedAt','reviewedBy','resolution','resolutionChoice'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['resolution','resolutionChoice'])
          || (request.resource.data.status == 'resolved' && resource.data.status != 'resolved'
            && validText(request.resource.data.resolution, 0, 600)))
        && request.resource.data.status in ['new','in-review','resolved']
        && (request.resource.data.status != 'resolved' || resource.data.status == 'resolved'
          || request.resource.data.get('resolutionChoice','') == '')
        && request.resource.data.reviewedAt == request.time
        && request.resource.data.reviewedBy == request.auth.uid;
      allow update: if isMe(resource.data.authorId)
        && resource.data.status == 'resolved'
        && validText(resource.data.get('resolution',''), 1, 600)
        && resource.data.get('resolutionChoice','') == ''
        && changedOnly(['resolutionChoice'])
        && request.resource.data.resolutionChoice in ['helped','needs-help'];
      allow update: if isMe(resource.data.authorId) && resource.data.status == 'in-review'
        && changedOnly(['hasUnreadSupplements','lastSupplementId']) && marksNewSupplement();
      allow update: if canTriageProductFeedback(appId) && resource.data.get('hasUnreadSupplements',false) == true
        && changedOnly(['hasUnreadSupplements']) && request.resource.data.hasUnreadSupplements == false;
      allow delete: if false;

      match /supplements/{supplementId} {
        function parentFeedback() {
          return get(feedbackPath()).data;
        }
        allow read: if canTriageProductFeedback(appId) || isMe(parentFeedback().authorId);
        allow create: if isMe(parentFeedback().authorId)
          && parentFeedback().status == 'in-review'
          && request.resource.data.keys().hasOnly(['message','createdAt'])
          && validText(request.resource.data.message, 3, 600)
          && request.resource.data.createdAt == request.time
          && getAfter(feedbackPath()).data.lastSupplementId == supplementId
          && getAfter(feedbackPath()).data.hasUnreadSupplements == true;
        allow update, delete: if false;
      }
    }

    // Todos os demais caminhos são negados por padrão.
    match /{document=**} { allow read, write: if false; }
  }
}
